<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="error-section">
  <div class="container error-container">
    <div class="error-code">500</div>
    <h1 class="error-title">Instabilidade no Bastião</h1>
    <p class="error-desc">
      Ocorreu uma falha interna no servidor ao processar sua solicitação. Nossos engenheiros já foram notificados.
    </p>
    <% if (typeof error !== 'undefined' && error) { %>
      <pre class="error-debug"><%= error %></pre>
    <% } %>
    <a href="/" class="btn btn-primary">Voltar para o Início</a>
  </div>
</section>

<%- include('../partials/footer') %>
