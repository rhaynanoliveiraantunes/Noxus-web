<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="hero-section">
  <div class="container hero-container">
    <div class="badge">⚔ Em Desenvolvimento</div>
    <h1 class="hero-title">Bem-vindo a <span class="text-accent"><%= serverName %></span></h1>
    <p class="hero-subtitle">
      O portal definitivo para membros da nossa comunidade do Discord. Acompanhe anúncios, regras, eventos e integre-se com a guilda.
    </p>

    <div class="construction-card">
